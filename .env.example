# ============================================================================
# VARIABLES DE ENTORNO — Consumo Estratégico
# ============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env  →  cp .env.example .env
# 2. Configura los valores reales para tu entorno
# 3. NUNCA subas .env a git (ya está en .gitignore)
#
# IMPORTANTE: Este archivo NUNCA debe contener secretos reales en git.
# Solo usar como referencia de qué variables son necesarias.
# ============================================================================

# ─── BASE DE DATOS ─────────────────────────────────────────────────────────
# Solo para Docker Compose. La conexión completa se define en backend/.env
DB_PASSWORD=tu_contraseña_segura_aqui_2024

# ─── JWT — SEGURIDAD ──────────────────────────────────────────────────────
# GENERA UN VALOR SEGURO:
# Linux/Mac:   python -c "import secrets; print(secrets.token_hex(64))"
# Windows:     python -c "import secrets; print(secrets.token_hex(64))"
#
# Debe ser: alfanumérico, mínimo 64 caracteres
JWT_SECRET_KEY=generar_con_comando_arriba_minimo_64_caracteres_alfanumericos

# ─── ENTORNO ────────────────────────────────────────────────────────────
# Valores permitidos: development, staging, production
ENVIRONMENT=development

# Debug: true solo en development. NUNCA en production
DEBUG=true
