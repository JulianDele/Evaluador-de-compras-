# ============================================================================
# VARIABLES DE ENTORNO — Backend FastAPI
# ============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env  →  cp .env.example .env
# 2. Rellena TODOS los valores marcados con "CAMBIAR"
# 3. Genera JWT_SECRET_KEY con:
#    python -c "import secrets; print(secrets.token_hex(64))"
# 4. Guarda el archivo en backend/.env
# 5. NUNCA subas este archivo a git
# ============================================================================

# ─── BASE DE DATOS ────────────────────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@servidor:puerto/base_datos
# Ejemplo local:   postgresql://ce_user:micontraseña@localhost:5432/consumo_estrategico
# Ejemplo Docker:  postgresql://ce_user:micontraseña@db:5432/consumo_estrategico
# Ejemplo remota:  postgresql://ce_user:micontraseña@prod-db.ejemplo.com:5432/consumo_estrategico
#
# ⚠️  CAMBIAR: Reemplaza la contraseña y servidor
DATABASE_URL=postgresql://ce_user:CAMBIAR_CONTRASEÑA@localhost:5432/consumo_estrategico

# ─── SEGURIDAD JWT ─────────────────────────────────────────────────────────
# Genera un valor aleatorio ÚNICO:
# 🔒 IMPORTANTE: Usar el mismo valor en todos los servidores de una aplicación
# 🔒 IMPORTANTE: NO compartir este valor entre diferentes ambientes (dev/prod)
#
# Generar:
#   python -c "import secrets; print(secrets.token_hex(64))"
#
# ⚠️  CAMBIAR: Por un valor de 64+ caracteres alfanuméricos
JWT_SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_DE_64_CHARS_MINIMO

# Algoritmo de firma de JWT (no cambiar a menos que sepas qué estás haciendo)
JWT_ALGORITHM=HS256

# Tiempo de expiración de tokens en horas
JWT_EXPIRE_HOURS=24

# ─── ARCHIVOS DE IMPORTACIÓN ──────────────────────────────────────────────
# Tamaño máximo de archivo permitido (en MB)
MAX_FILE_SIZE_MB=10

# Directorio donde se almacenan los archivos subidos
# Rutas recomendadas:
#   Desarrollo:     ./uploads  (relativa al directorio backend/)
#   Docker:         /var/app/uploads  (volumen persistente)
#   Producción:     /mnt/uploads o similar en servidor real
UPLOAD_DIR=./uploads

# ─── ENTORNO ────────────────────────────────────────────────────────────
# development, staging, production
# ⚠️  CAMBIAR para producción
ENVIRONMENT=development

# Activar debug y documentación Swagger
# CAMBIAR a 'false' en producción (problema de seguridad)
DEBUG=false

# ─── POOL DE CONEXIONES BD ─────────────────────────────────────────────────
# Para free-tier (Supabase, Railway, Render): usa 2-3
# Para servidores dedicados: usa 5-10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─── CORS — Orígenes permitidos ────────────────────────────────────────────
# URLs desde las que se puede acceder a esta API
# Separar múltiples orígenes con coma (sin espacios)
# Ejemplos:
#   Local:        http://localhost:5173,http://localhost:3000
#   Producción:   https://app.ejemplo.com,https://www.ejemplo.com
#   Docker:       http://frontend:80,http://localhost:3000
#
# ⚠️  CAMBIAR para tu dominio en producción
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
